{
  "name": "automation-exercise-agent",
  "version": "1.0.0",
  "description": "Production-ready Playwright TypeScript end-to-end and API testing framework for Automation Exercise",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:regression": "playwright test --grep \"@regression\"",
    "report": "playwright show-report",
    "slice": "ts-node scripts/slice-context.ts"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "qa",
    "testing",
    "e2e",
    "api-testing"
  ],
  "author": "Ngoc-Senior Fullstack QC Engineer",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^9.5.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "dotenv": "^16.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
